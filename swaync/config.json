{
  "$schema": "/etc/xdg/swaync/configSchema.json",
  "ignore-gtk-theme": true,
  "cssPriority": "user",
  "layer-shell": true,
  "layer-shell-cover-screen": true,
  "layer": "overlay",
  "positionX": "right",
  "positionY": "top",
  "control-center-layer": "overlay",
  "control-center-positionX": "center",
  "control-center-positionY": "bottom",
  "control-center-margin-top": 14,
  "control-center-margin-bottom": 0,
  "control-center-margin-left": 0,
  "control-center-margin-right": 0,
  "control-center-exclusive-zone": false,
  "control-center-width": 460,
  "control-center-height": 560,
  "fit-to-screen": false,
  "notification-window-width": 390,
  "notification-window-height": 480,
  "notification-body-image-width": 240,
  "notification-body-image-height": 120,
  "notification-inline-replies": true,
  "notification-2fa-action": true,
  "timeout": 8,
  "timeout-low": 4,
  "timeout-critical": 0,
  "transition-time": 140,
  "keyboard-shortcuts": true,
  "notification-grouping": true,
  "image-visibility": "when-available",
  "relative-timestamps": true,
  "hide-on-clear": false,
  "hide-on-action": true,
  "text-empty": "No notifications",
  "script-fail-notify": true,
  "widgets": [
    "title",
    "dnd",
    "notifications"
  ],
  "widget-config": {
    "title": {
      "text": "Notifications",
      "clear-all-button": true,
      "button-text": "Clear"
    },
    "dnd": {
      "text": "DND"
    },
    "notifications": {
      "vexpand": true
    }
  }
}
