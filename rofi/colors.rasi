/* Palette commune : sombre, neutre et lisible. */
* {
    background:     #0d0f12f2;
    background-alt: #171a1fee;
    surface:        #20242a;
    foreground:     #e8e6e3;
    foreground-alt: #969ba3;
    selected:       #2b3139;
    accent:         #9aaec4;
    urgent:         #d28b8b;
    border-color:   #2b3037;
}
