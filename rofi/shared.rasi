@import "colors.rasi"

configuration {
    font: "JetBrainsMono Nerd Font 11";
    show-icons: true;
    display-drun: "";
    drun-display-format: "{name}";
}

* {
    background-color: transparent;
    text-color: @foreground;
    margin: 0px;
    padding: 0px;
    spacing: 0px;
}

window {
    location: center;
    anchor: center;
    transparency: "real";
    background-color: @background;
    border: 1px;
    border-color: @border-color;
    border-radius: 8px;
}

mainbox {
    spacing: 12px;
    padding: 14px;
    children: [ inputbar, message, listview ];
}

inputbar {
    spacing: 9px;
    padding: 9px 11px;
    background-color: @background-alt;
    border-radius: 5px;
    children: [ prompt, entry ];
}

prompt { text-color: @accent; }
entry { placeholder: "Rechercher"; placeholder-color: @foreground-alt; }
prompt, entry, element-icon, element-text { vertical-align: 0.5; }
message { padding: 0px 2px; }
textbox { text-color: @foreground-alt; }

listview {
    scrollbar: false;
    cycle: true;
    dynamic: true;
    fixed-height: true;
}

element {
    spacing: 10px;
    padding: 8px 10px;
    border-radius: 4px;
}

element normal.normal, element alternate.normal { background-color: transparent; text-color: @foreground; }
element selected.normal, element selected.active { background-color: @selected; text-color: @foreground; }
element normal.active, element alternate.active { text-color: @accent; }
element normal.urgent, element alternate.urgent { text-color: @urgent; }
element-icon { size: 22px; }
element-text { text-color: inherit; }
