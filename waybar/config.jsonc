{
  "layer": "top",
  "position": "bottom",
  "height": 32,
  "margin-top": 0,
  "margin-right": 0,
  "margin-bottom": 0,
  "margin-left": 0,
  "fixed-center": true,
  "spacing": 0,

  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["group/status"],

  "hyprland/workspaces": {
    "active-only": true,
    "all-outputs": false,
    "format": "Activities  {name}",
    "on-click": "activate",
    "disable-scroll": true
  },

  "clock": {
    "format": "{:%a  %H:%M}",
    "tooltip-format": "{:%A %d %B %Y\n%H:%M:%S}",
    "interval": 1
  },

  "group/status": {
    "orientation": "horizontal",
    "modules": ["network", "pulseaudio", "memory", "battery"]
  },

  "network": {
    "format-wifi": "󰤨",
    "format-ethernet": "󰈀",
    "format-linked": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip-format-wifi": "{essid}  {signalStrength}%",
    "tooltip-format-ethernet": "{ifname}",
    "tooltip-format-disconnected": "Network disconnected",
    "on-click": "foot nmtui"
  },

  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "󰝟",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    },
    "tooltip-format": "Volume  {volume}%",
    "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
    "scroll-step": 5
  },

  "memory": {
    "format": "󰍛  {used:0.1f}G",
    "tooltip-format": "Memory  {used:0.1f} GiB / {total:0.1f} GiB",
    "interval": 5,
    "on-click": "foot btop"
  },

  "battery": {
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-plugged": "󰚥",
    "format-full": "󰁹",
    "format-icons": ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
    "tooltip-format": "Battery  {capacity}%  {time}"
  }
}
