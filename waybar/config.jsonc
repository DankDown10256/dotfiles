{
  "layer": "top",
  "position": "top",
  "height": 36,
  "margin-top": 8,
  "exclusive": false,
  "passthrough": false,
  "spacing": 0,

  "modules-left": [],
  "modules-center": [
    "dwl/tags",
    "clock"
  ],
  "modules-right": [],

  "dwl/tags": {
    "num-tags": 9,
    "tag-labels": [
      "1", "2", "3", "4", "5",
      "6", "7", "8", "9"
    ],
    "disable-click": false
  },

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A %d %B %Y}",
    "interval": 30
  }
}
