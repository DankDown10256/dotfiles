general {
    output_format = "i3bar"
    colors = false
    interval = 2
}

order += "memory"
order += "volume master"
order += "wireless _first_"
order += "battery all"
order += "tztime local"

memory {
    format = "RAM: %used"
    memory_used_method = "memavailable"
    unit = "Gi"
    decimals = 1
}

volume master {
    format = "VOL: %volume"
    format_muted = "VOL: muted"
    device = "pulse"
}

wireless _first_ {
    format_up = "WIFI: %quality"
    format_down = "WIFI: disconnected"
}

battery all {
    format = "BAT: %percentage"
    format_down = "BAT: unavailable"
    integer_battery_capacity = true
}

tztime local {
    format = "%H:%M"
}

